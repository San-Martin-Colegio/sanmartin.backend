PORT=3000
NODE_ENV=development
# Lista separada por comas. En producción, usa la URL real del frontend.
CORS_ORIGINS=http://localhost:4200

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sistema_inventario_sm
# En producción siempre debe ser false; usa las migraciones versionadas.
DB_SYNC=false
DB_SSL=false

# JWT Security
# Generar con: openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Clave Base64 de exactamente 32 bytes. No debe reutilizar JWT_SECRET.
# Generar con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Solo para crear el administrador en una instalación nueva; no cambia claves existentes.
# ADMIN_INITIAL_PASSWORD=
