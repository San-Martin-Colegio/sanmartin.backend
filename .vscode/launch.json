{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug NestJS Backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "console": "integratedTerminal",
      "restart": true,
      "port": 9229,
      "autoAttachFilter": "smart"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to NestJS (Port 9229)",
      "port": 9229,
      "restart": true
    }
  ]
}
