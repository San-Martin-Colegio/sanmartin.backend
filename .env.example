PORT=3000
NODE_ENV=development
# Lista separada por comas. En producción, usa la URL real del frontend.
CORS_ORIGINS=http://localhost:4200

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sistema_inventario_sm
# Mantener el valor actual hasta contar con una migración base completa y un respaldo verificado.
DB_SYNC=true

# JWT Security
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=8h

# Solo para crear el administrador en una instalación nueva; no cambia claves existentes.
# ADMIN_INITIAL_PASSWORD=
